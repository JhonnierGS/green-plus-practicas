---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../app/home/components/hero';
import { Stats } from '../app/home/components/stats';
import { QuienesSomos } from '../app/home/components/quienes-somos';
import { Mission} from '../app/home/components/mission';
import { NuestrosNegocios } from '../app/home/components/nuestros-negocios';
import { Operations } from '../app/home/components/operations';
import {Certifications} from '../app/home/components/certifications';
import { Sostenibilidad } from '../app/home/components/sostenibilidad';
import { Fondo } from '../app/home/components/fondo';
import { Footer } from '../ui/Footer';


---
<Layout title="Home |  Green plus" activePage="inicio">
	<Hero client:load/>
	<div id="stats">
		<Stats client:load/>
	</div>
	<QuienesSomos client:load/>
	<Mission client:load/>
	<NuestrosNegocios client:load/>
	<Operations client:load/>
	<Certifications client:load/>
	<Sostenibilidad client:load/>
	<Fondo client:load/>
	<Footer client:load/>
	
	<script>
		import "../scripts/operations-animation.js";
	</script>
</Layout>
